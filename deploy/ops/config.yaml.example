controlPlane:
  scf:
    region: ap-guangzhou
    namespace: default
    functionName: mini-cloud-control-plane
    role: mini-cloud
    image: ccr.ccs.tencentyun.com/mini-cloud/control-plane
    publicDomain: control.apps.whatcloud.cn
    description: mini-cloud control-plane
    memoryMB: 512
    timeoutSec: 30
    initSec: 30

planes:
  - name: mini-cloud-tencent-ops
    provider: tencent
    region: ap-guangzhou
    ssh:
      host: myserver-tencent
    terraform:
      dir: deploy/terraform/ops/tencent
      workspace: tencent
      varFile: deploy/terraform/ops/tencent/terraform.tfvars

  - name: mini-cloud-aliyun-ops
    provider: aliyun
    region: cn-beijing
    ssh:
      host: myserver2
    terraform:
      dir: deploy/terraform/ops/aliyun
      workspace: aliyun
      varFile: deploy/terraform/ops/aliyun/terraform.tfvars

install:
  root: /opt/mini-cloud
  ingressBaseDomain: apps.whatcloud.cn
  registryMirror: ""

binaries:
  controlPlane: dist/release/linux-amd64/control-plane
  cloudPlane: dist/release/linux-amd64/cloud-plane
  nodeAgent: dist/release/linux-amd64/node-agent
  webDist: web/dist

tokens:
  controlPlaneAdmin: ""
  controlPlaneSouthbound: ""
  nodeAgent: ""

provider:
  tencentCredentialFile: ~/.tccli/default.credential

observability:
  workloadOTLPEndpoint: ""
