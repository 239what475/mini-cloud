provider_name = "aliyun"
platform_mode = "existing_ecs"
platform_name = "mini-cloud-aliyun-lab"
environment   = "lab"
owner         = "operator"

control_plane_cidrs = [
  "0.0.0.0/0"
]

ingress_cidrs = [
  "0.0.0.0/0"
]

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

existing_ecs_instance_id          = "i-xxxxxxxx"
existing_ecs_instance_name        = "mini-cloud-entry"
existing_ecs_instance_type        = "ecs.e-c1m1.large"
existing_ecs_image_id             = "debian_13_x64.vhd"
existing_ecs_public_ip            = "203.0.113.10"
existing_ecs_private_ip           = "172.29.199.49"
existing_ecs_ssh_host             = "myserver2"
existing_ecs_vpc_id               = "vpc-xxxxxxxx"
existing_ecs_vswitch_id           = "vsw-xxxxxxxx"
existing_ecs_vswitch_cidr_block   = "172.29.192.0/20"
existing_ecs_security_group_id    = "sg-xxxxxxxx"
existing_ecs_role_name            = "mini-cloud"

aliyun = {
  region_id     = "cn-beijing"
  zone_id       = "cn-beijing-f"
  instance_type = "ecs.e-c1m1.large"
  image_id      = "replace-with-node-image-id"
}

