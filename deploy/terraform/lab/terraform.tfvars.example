provider_name = "aliyun"
platform_mode = "managed_cvm"
platform_name = "mini-cloud-v3-lab"
environment   = "lab"
owner         = "student"

vpc_cidr_block    = "10.88.0.0/16"
subnet_cidr_block = "10.88.1.0/24"

# admin_cidrs 只用于 SSH 登录 platform host。
admin_cidrs = [
  "203.0.113.10/32"
]

# control_plane_cidrs 用于外部 control-plane/admin 访问 cloud-plane gRPC。
control_plane_cidrs = [
  "203.0.113.10/32"
]

# ingress_cidrs 用于用户/CDN 访问 Caddy HTTP 入口。
ingress_cidrs = [
  "203.0.113.10/32"
]

# 这里填本机 SSH 公钥路径。
# Terraform 会读取这把公钥，并自动在云侧创建登录密钥对。
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Terraform 只负责创建真实云底座，不负责安装 mini-cloud 进程。
# 底座创建后，用 deploy/lab/install.sh 通过 SSH 安装 control-plane 和 cloud-plane。
# 入口机不运行 node-agent；runtime node 会从入口机内网 artifact server 下载 node-agent。

# 复用腾讯云轻量应用服务器作为入口机时，改成：
#
# provider_name = "tencent"
# platform_mode = "existing_lighthouse"
# existing_lighthouse_instance_id = "lhins-xxxxxxxx"
# existing_lighthouse_public_ip   = "203.0.113.10"
# existing_lighthouse_private_ip  = "10.1.0.6"
# existing_lighthouse_ssh_host    = "myserver"
# existing_ccn_id                 = "ccn-xxxxxxxx"
#
# Terraform 会创建 runtime CVM VPC、安全组和密钥，并把 runtime VPC 关联到已有 CCN。
# deploy/lab/bootstrap.sh 会把 Lighthouse 关联到同一个 CCN。
# 注意 vpc_cidr_block/subnet_cidr_block 不要和 Lighthouse 私网 CIDR 冲突。

aliyun = {
  region_id     = "cn-beijing"
  zone_id       = "cn-beijing-f"
  instance_type = "ecs.u1-c1m1.large"
  image_id      = "replace-with-a-region-available-image-id"
}

# 如果要切到腾讯云，只需要把 provider_name 改成 "tencent"，
# 然后填写下面这组字段；未被选中的 provider 配置不会参与本次部署。
#
# tencent = {
#   region_id     = "ap-beijing"
#   zone_id       = "ap-beijing-6"
#   instance_type = "S5.MEDIUM4"
#   image_id      = "img-xxxxxxxx"
# }
