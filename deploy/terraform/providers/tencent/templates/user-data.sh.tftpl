#!/usr/bin/env bash
set -euo pipefail

decode_base64() {
  printf '%s' "$1" | base64 -d
}

CLOUD_PLANE_CONFIG_DIR=/etc/mini-cloud/cloud-plane
INSTALL_ROOT="$(decode_base64 '${base64encode(install_root)}')"
PLATFORM_NAME="$(decode_base64 '${base64encode(platform_name)}')"
PLATFORM_INSTANCE_NAME="$(decode_base64 '${base64encode(platform_instance_name)}')"
PROVIDER_NAME="$(decode_base64 '${base64encode(provider_name)}')"
REGION_ID="$(decode_base64 '${base64encode(region_id)}')"
PLATFORM_INSTANCE_TYPE="$(decode_base64 '${base64encode(platform_instance_type)}')"
PLATFORM_NODE_SYSTEM_RESERVED_CPU_MILLI=${platform_node_system_reserved_cpu_milli}
PLATFORM_NODE_SYSTEM_RESERVED_MEMORY_MI=${platform_node_system_reserved_memory_mi}
CLOUD_PLANE_GRPC_PORT=${cloud_plane_grpc_port}
INGRESS_HTTP_PORT=${ingress_http_port}
EGRESS_PROXY_PORT=${egress_proxy_port}
RUNTIME_HOST_PORT_MIN=${runtime_host_port_min}
RUNTIME_HOST_PORT_MAX=${runtime_host_port_max}
CLOUD_PLANE_BINARY_URL="$(decode_base64 '${base64encode(cloud_plane_binary_url)}')"
CLOUD_PLANE_BINARY_SHA256="$(decode_base64 '${base64encode(cloud_plane_binary_sha256)}')"
AGENT_BINARY_URL="$(decode_base64 '${base64encode(agent_binary_url)}')"
AGENT_BINARY_SHA256="$(decode_base64 '${base64encode(agent_binary_sha256)}')"
DOCKER_REGISTRY_MIRROR="$(decode_base64 '${base64encode(image_pull_registry_mirror)}')"
WORKLOAD_LOG_LOKI_URL="$(decode_base64 '${base64encode(workload_log_loki_url)}')"
WORKLOAD_LOG_LOKI_TENANT_ID="$(decode_base64 '${base64encode(workload_log_loki_tenant_id)}')"
WORKLOAD_OTLP_ENDPOINT="$(decode_base64 '${base64encode(workload_otlp_endpoint)}')"
CONTROL_PLANE_SOUTHBOUND_TOKEN="$(decode_base64 '${base64encode(control_plane_southbound_token)}')"
NODE_AGENT_BOOTSTRAP_TOKEN="$(decode_base64 '${base64encode(node_agent_bootstrap_token)}')"
CLOUD_PLANE_CONFIG_SEED_JSON="$(decode_base64 '${base64encode(cloud_plane_config_seed_json)}')"

BOOTSTRAP_LOG="$${INSTALL_ROOT}/cloud-init-bootstrap.log"
CLOUD_PLANE_LOG="$${INSTALL_ROOT}/cloud-plane.log"
POSTGRES_IMAGE="docker.io/library/postgres:17"
METADATA_BASE="http://metadata.tencentyun.com/latest/meta-data"

log() {
  printf '[mini-cloud cloud-init] %s\n' "$*" | tee -a "$BOOTSTRAP_LOG"
}

metadata_get() {
  local path="$1"
  curl -fsS "$METADATA_BASE/$path"
}

configure_docker_mirror_if_needed() {
  if [[ -z "$${DOCKER_REGISTRY_MIRROR}" ]]; then
    return 0
  fi

  install -d -m 0755 /etc/docker
  python3 - "$${DOCKER_REGISTRY_MIRROR}" >/etc/docker/daemon.json <<'PY_DOCKER_DAEMON'
import json
import sys

print(json.dumps({"registry-mirrors": [sys.argv[1]]}, ensure_ascii=False, indent=2))
PY_DOCKER_DAEMON
}

ensure_tinyproxy() {
  cat >/etc/tinyproxy/tinyproxy.conf <<EOF_TINYPROXY
User tinyproxy
Group tinyproxy
Port $${EGRESS_PROXY_PORT}
Listen 0.0.0.0
Timeout 600
DefaultErrorFile "/usr/share/tinyproxy/default.html"
StatFile "/usr/share/tinyproxy/stats.html"
LogFile "/var/log/tinyproxy/tinyproxy.log"
LogLevel Info
PidFile "/run/tinyproxy/tinyproxy.pid"
MaxClients 100
Allow 127.0.0.1
Allow ${subnet_cidr_block}
ViaProxyName "mini-cloud-egress-proxy"
EOF_TINYPROXY
  systemctl enable --now tinyproxy
  systemctl restart tinyproxy
}

ensure_caddy() {
  install -d -m 0755 /etc/mini-cloud/ingress
  if [[ ! -f /etc/mini-cloud/ingress/Caddyfile ]]; then
    cat >/etc/mini-cloud/ingress/Caddyfile <<EOF_CADDY
{
  auto_https off
  admin localhost:2019
}

:$${INGRESS_HTTP_PORT} {
  respond "mini-cloud ingress is waiting for cloud-plane routes" 404
}
EOF_CADDY
  fi
  if docker ps -a --format '{{.Names}}' | grep -qx mini-cloud-caddy; then
    docker start mini-cloud-caddy || true
    docker exec mini-cloud-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile || true
    return 0
  fi
  docker_pull_with_retry docker.io/library/caddy:2
  docker run -d \
    --name mini-cloud-caddy \
    --restart unless-stopped \
    --network host \
    -v /etc/mini-cloud/ingress:/etc/caddy:ro \
    docker.io/library/caddy:2
}

docker_pull_with_retry() {
  local image="$1"
  local max_attempts="$${2:-5}"
  local pull_timeout_seconds="$${3:-600}"

  for attempt in $(seq 1 "$${max_attempts}"); do
    if timeout "$${pull_timeout_seconds}" docker pull "$${image}"; then
      return 0
    fi
    if [[ "$${attempt}" -lt "$${max_attempts}" ]]; then
      log "docker pull $${image} failed or timed out after $${pull_timeout_seconds}s on attempt $${attempt}/$${max_attempts}; retrying in 10 seconds"
      sleep 10
    fi
  done

  log "docker pull $${image} failed after $${max_attempts} attempts with $${pull_timeout_seconds}s timeout per attempt"
  return 1
}

ensure_postgres() {
  if docker ps -a --format '{{.Names}}' | grep -qx mini-cloud-postgres; then
    docker start mini-cloud-postgres || true
    return 0
  fi

  docker volume create mini-cloud-postgres-data >/dev/null
  docker_pull_with_retry "$${POSTGRES_IMAGE}"
  docker run -d \
    --name mini-cloud-postgres \
    --restart unless-stopped \
    -p 127.0.0.1:5432:5432 \
    -e POSTGRES_USER=mini_cloud \
    -e POSTGRES_PASSWORD=mini_cloud \
    -e POSTGRES_DB=mini_cloud_cloud_plane \
    -v mini-cloud-postgres-data:/var/lib/postgresql/data \
    "$${POSTGRES_IMAGE}"
}

wait_for_postgres() {
  for _ in $(seq 1 60); do
    if docker exec mini-cloud-postgres pg_isready -h 127.0.0.1 -p 5432 -U mini_cloud -d mini_cloud_cloud_plane >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  log "postgres is not ready in time"
  docker logs mini-cloud-postgres || true
  exit 1
}

download_binary() {
  local url="$1"
  local sha256="$2"
  local output_path="$3"
  local label="$4"

  log "download $label binary from $url"
  curl -fsSL "$url" -o "$output_path"
  if [[ -n "$sha256" ]]; then
    log "verify $label binary sha256"
    printf '%s  %s\n' "$sha256" "$output_path" | sha256sum -c -
  fi
  chmod 0755 "$output_path"
}

install_platform_binaries() {
  download_binary "$CLOUD_PLANE_BINARY_URL" "$CLOUD_PLANE_BINARY_SHA256" "$INSTALL_ROOT/bin/cloud-plane" "cloud-plane"
  download_binary "$AGENT_BINARY_URL" "$AGENT_BINARY_SHA256" "$INSTALL_ROOT/bin/node-agent" "node-agent"
}

write_cloud_plane_config() {
  local platform_private_ip="$1"
  local cloud_plane_internal_grpc_endpoint="$${platform_private_ip}:$${CLOUD_PLANE_GRPC_PORT}"

  install -d -m 0755 "$${CLOUD_PLANE_CONFIG_DIR}"
  python3 - \
    "$${CLOUD_PLANE_CONFIG_SEED_JSON}" \
    "$${cloud_plane_internal_grpc_endpoint}" \
    "$${AGENT_BINARY_URL}" \
    "$${AGENT_BINARY_SHA256}" \
    "$${CLOUD_PLANE_GRPC_PORT}" \
    "$${CONTROL_PLANE_SOUTHBOUND_TOKEN}" \
    "$${NODE_AGENT_BOOTSTRAP_TOKEN}" \
    "$${EGRESS_PROXY_PORT}" \
    >"$${CLOUD_PLANE_CONFIG_DIR}/cloud-plane.yaml" <<'PY_CLOUD_PLANE_CONFIG'
import json
import sys

config = json.loads(sys.argv[1])
internal_grpc_endpoint = sys.argv[2]
agent_binary_url = sys.argv[3]
agent_binary_sha256 = sys.argv[4]
grpc_port = sys.argv[5]
southbound_token = sys.argv[6]
node_agent_bootstrap_token = sys.argv[7]
egress_proxy_port = sys.argv[8]

config["server"] = {"listenGRPCAddr": f"0.0.0.0:{grpc_port}"}
config["database"] = {"url": "postgres://mini_cloud:mini_cloud@127.0.0.1:5432/mini_cloud_cloud_plane?sslmode=disable"}
config["controlPlane"] = {"auth": {"bearerToken": southbound_token}}
config["nodeAgent"] = dict(config.get("nodeAgent") or {})
config["nodeAgent"]["connectEndpoint"] = internal_grpc_endpoint
config["nodeAgent"]["auth"] = {
    "bootstrapToken": node_agent_bootstrap_token,
    "sessionTTL": "24h",
}
config["nodeAgent"]["artifact"] = {
    "binaryUrl": agent_binary_url,
    "binarySha256": agent_binary_sha256,
}
runtime_provisioning = dict(config.get("runtimeProvisioning") or {})
egress = dict(runtime_provisioning.get("egress") or {})
proxy = dict(egress.get("proxy") or {})
proxy["enabled"] = True
proxy["endpoint"] = f"http://{internal_grpc_endpoint.rsplit(':', 1)[0]}:{egress_proxy_port}"
egress["proxy"] = proxy
runtime_provisioning["egress"] = egress
config["runtimeProvisioning"] = runtime_provisioning
config["observability"] = dict(config.get("observability") or {})
config["observability"].setdefault("logs", {"lokiURL": "", "lokiTenantID": ""})
config["observability"].setdefault("traces", {"otlpEndpoint": ""})

def emit_value(value, indent=0):
    pad = "  " * indent
    if isinstance(value, dict):
        lines = []
        for key, item in value.items():
            if isinstance(item, (dict, list)):
                lines.append(f"{pad}{key}:")
                lines.extend(emit_value(item, indent + 1))
            else:
                lines.append(f"{pad}{key}: {json.dumps(item, ensure_ascii=False)}")
        return lines
    if isinstance(value, list):
        lines = []
        for item in value:
            if isinstance(item, (dict, list)):
                lines.append(f"{pad}-")
                lines.extend(emit_value(item, indent + 1))
            else:
                lines.append(f"{pad}- {json.dumps(item, ensure_ascii=False)}")
        return lines
    return [f"{pad}{json.dumps(value, ensure_ascii=False)}"]

print("\n".join(emit_value(config)))
PY_CLOUD_PLANE_CONFIG
  chmod 0600 "$${CLOUD_PLANE_CONFIG_DIR}/cloud-plane.yaml"
}
write_cloud_plane_service() {
  cat >/etc/systemd/system/mini-cloud-cloud-plane.service <<EOF_SYSTEMD
[Unit]
Description=mini-cloud cloud-plane
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=$${INSTALL_ROOT}
ExecStart=$${INSTALL_ROOT}/bin/cloud-plane --config $${CLOUD_PLANE_CONFIG_DIR}/cloud-plane.yaml
Restart=always
RestartSec=5
StandardOutput=append:$${CLOUD_PLANE_LOG}
StandardError=append:$${CLOUD_PLANE_LOG}

[Install]
WantedBy=multi-user.target
EOF_SYSTEMD
}

write_platform_agent_service() {
  # cloud-plane 所在的固定入口机也要作为基础 node 接入。
  # 否则上层 control-plane 只能看到“plane 活着了”，却看不到任何初始可调度容量。
  cat >"$${INSTALL_ROOT}/node-agent.yaml" <<EOF_NODE_AGENT_CONFIG
server:
  url: 127.0.0.1:$${CLOUD_PLANE_GRPC_PORT}
auth:
  bootstrapToken: "$${NODE_AGENT_BOOTSTRAP_TOKEN}"
platform:
  name: "$${PLATFORM_NAME}"
node:
  provider: "$${PROVIDER_NAME}"
  region: "$${REGION_ID}"
  name: "$${PLATFORM_INSTANCE_NAME}"
  privateIP: "$${PLATFORM_PRIVATE_IP}"
  publicIP: "$${PLATFORM_PUBLIC_IP}"
  instanceID: "$${INSTANCE_ID}"
  instanceType: "$${PLATFORM_INSTANCE_TYPE}"
capacity:
  systemReserved:
    cpuMilli: $${PLATFORM_NODE_SYSTEM_RESERVED_CPU_MILLI}
    memoryMi: $${PLATFORM_NODE_SYSTEM_RESERVED_MEMORY_MI}
  agentReserved:
    cpuMilli: 200
    memoryMi: 256
  evictionReserved:
    memoryMi: 512
agent:
  version: 0.1.0
  heartbeatInterval: 15s
  workInterval: 5s
runtime:
  type: docker
  hostPortRange:
    min: $${RUNTIME_HOST_PORT_MIN}
    max: $${RUNTIME_HOST_PORT_MAX}
observability:
  workloadLogLokiURL: "$${WORKLOAD_LOG_LOKI_URL}"
  workloadLogLokiTenantID: "$${WORKLOAD_LOG_LOKI_TENANT_ID}"
  workloadOTLPEndpoint: "$${WORKLOAD_OTLP_ENDPOINT}"
EOF_NODE_AGENT_CONFIG
  chmod 0600 "$${INSTALL_ROOT}/node-agent.yaml"

  cat >"$${INSTALL_ROOT}/bin/start-agent.sh" <<EOF_AGENT_START
#!/usr/bin/env bash
set -euo pipefail
exec $${INSTALL_ROOT}/bin/node-agent --config $${INSTALL_ROOT}/node-agent.yaml
EOF_AGENT_START
  chmod 0755 "$${INSTALL_ROOT}/bin/start-agent.sh"

  cat >/etc/systemd/system/mini-cloud-node-agent.service <<EOF_SYSTEMD
[Unit]
Description=mini-cloud platform node agent
After=network-online.target docker.service mini-cloud-cloud-plane.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=$${INSTALL_ROOT}/bin/start-agent.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF_SYSTEMD
}

wait_for_cloud_plane_grpc() {
  for _ in $(seq 1 60); do
    if timeout 1 bash -c "</dev/tcp/127.0.0.1/$${CLOUD_PLANE_GRPC_PORT}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  log "cloud-plane gRPC port is not ready in time"
  systemctl status mini-cloud-cloud-plane.service --no-pager || true
  journalctl -u mini-cloud-cloud-plane.service --no-pager -n 120 | tee -a "$BOOTSTRAP_LOG" || true
  if [[ -f "$CLOUD_PLANE_LOG" ]]; then
    tail -n 120 "$CLOUD_PLANE_LOG" | tee -a "$BOOTSTRAP_LOG" || true
  fi
  exit 1
}

wait_for_platform_node_ready() {
  # cloud-plane 不再暴露 HTTP snapshot；这里只确认 node-agent 已启动，后续由 control-plane 通过 control-plane southbound gRPC services 同步真实状态。
  sleep 2
}

if ! command -v apt-get >/dev/null 2>&1; then
  log "image does not provide apt-get; platform bootstrap currently expects a Debian/Ubuntu style image"
  exit 1
fi

install -d -m 0755 "$${INSTALL_ROOT}" "$${INSTALL_ROOT}/bin" /var/lib/mini-cloud-node-agent
touch "$${BOOTSTRAP_LOG}"
touch "$${CLOUD_PLANE_LOG}"

INSTANCE_ID="$(metadata_get instance-id)"
PLATFORM_PRIVATE_IP="$(metadata_get local-ipv4)"
PLATFORM_PUBLIC_IP="$(metadata_get public-ipv4 || true)"

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io curl ca-certificates python3 tinyproxy

configure_docker_mirror_if_needed
systemctl daemon-reload || true
systemctl enable --now docker
systemctl restart docker

ensure_tinyproxy
ensure_caddy
ensure_postgres
wait_for_postgres
install_platform_binaries
write_cloud_plane_config "$PLATFORM_PRIVATE_IP"
write_cloud_plane_service
write_platform_agent_service

systemctl daemon-reload
systemctl enable --now mini-cloud-cloud-plane.service
wait_for_cloud_plane_grpc
systemctl enable --now mini-cloud-node-agent.service
wait_for_platform_node_ready

log "cloud-init bootstrap completed"
