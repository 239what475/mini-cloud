services:
  postgres:
    image: postgres:17
    container_name: mini-cloud-platform-postgres
    restart: unless-stopped
    ports:
      - "127.0.0.1:5432:5432"
    environment:
      POSTGRES_USER: mini_cloud
      POSTGRES_PASSWORD: mini_cloud
      POSTGRES_DB: postgres
    volumes:
      - mini-cloud-platform-postgres-data:/var/lib/postgresql/data
      - ./initdb/01-create-databases.sql:/docker-entrypoint-initdb.d/01-create-databases.sql:ro

volumes:
  mini-cloud-platform-postgres-data:
