services:
  alloy:
    image: ${MINICLOUD_IMAGE_PREFIX:-}grafana/alloy:v1.15.1
    container_name: mini-cloud-plane-alloy
    environment:
      MINICLOUD_PLATFORM_NAME: ${MINICLOUD_PLATFORM_NAME}
      MINICLOUD_PLANE_NAME: ${MINICLOUD_PLANE_NAME}
      MINICLOUD_PROVIDER: ${MINICLOUD_PROVIDER}
      MINICLOUD_REGION: ${MINICLOUD_REGION}
      MINICLOUD_CENTER_LOKI_PUSH_URL: ${MINICLOUD_CENTER_LOKI_PUSH_URL}
      MINICLOUD_LOKI_TENANT_ID: ${MINICLOUD_LOKI_TENANT_ID:-}
    command:
      - run
      - /etc/alloy/config.alloy
    ports:
      - "3101:3101"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./alloy/config.alloy:/etc/alloy/config.alloy:ro
      - /var/log/mini-cloud:/var/log/mini-cloud:ro
      - mini-cloud-plane-alloy-data:/var/lib/alloy/data

  otel-collector:
    image: ${MINICLOUD_IMAGE_PREFIX:-}otel/opentelemetry-collector-contrib:0.103.1
    container_name: mini-cloud-plane-otel-collector
    environment:
      MINICLOUD_CENTER_TEMPO_OTLPHTTP_URL: ${MINICLOUD_CENTER_TEMPO_OTLPHTTP_URL}
    command:
      - --config=/etc/otelcol-contrib/config.yml
    ports:
      - "4318:4318"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./otel-collector/config.yml:/etc/otelcol-contrib/config.yml:ro

  prometheus:
    image: ${MINICLOUD_IMAGE_PREFIX:-}prom/prometheus:v2.53.4
    container_name: mini-cloud-plane-prometheus
    command:
      - --config.file=/etc/prometheus/config.yml
      - --storage.tsdb.path=/prometheus
      - --web.enable-lifecycle
    ports:
      - "19090:9090"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./prometheus/config.yml:/etc/prometheus/config.yml:ro
      - ./prometheus/file_sd:/etc/prometheus/file_sd:ro
      - mini-cloud-plane-prometheus-data:/prometheus

volumes:
  mini-cloud-plane-alloy-data:
  mini-cloud-plane-prometheus-data:
