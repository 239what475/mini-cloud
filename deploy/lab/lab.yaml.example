controlPlane:
  ssh:
    host: myserver-control
    keyPath: ""
    options: []
  listenHTTPAddr: 0.0.0.0:18080

planes:
  - name: mini-cloud-tencent-lab
    provider: tencent
    region: ap-guangzhou
    ssh:
      host: myserver-tencent
    terraform:
      dir: deploy/terraform/lab
      workspace: tencent
      varFile: deploy/terraform/lab/tencent.tfvars

  - name: mini-cloud-aliyun-lab
    provider: aliyun
    region: cn-beijing
    ssh:
      host: myserver2
    terraform:
      dir: deploy/terraform/lab
      workspace: aliyun
      varFile: deploy/terraform/lab/aliyun.tfvars

install:
  root: /opt/mini-cloud
  ingressBaseDomain: apps.whatcloud.cn
  registryMirror: ""

binaries:
  controlPlane: dist/release/linux-amd64/control-plane
  cloudPlane: dist/release/linux-amd64/cloud-plane
  nodeAgent: dist/release/linux-amd64/node-agent
  webDist: web/dist

tokens:
  controlPlaneAdmin: ""
  controlPlaneSouthbound: ""
  nodeAgent: ""

provider:
  tencentCredentialFile: ~/.tccli/default.credential

observability:
  workloadOTLPEndpoint: ""
