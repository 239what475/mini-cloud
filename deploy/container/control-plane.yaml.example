server:
  httpAddr: "0.0.0.0:9000"

ui:
  dir: "/opt/mini-cloud/web"

auth:
  adminToken: "replace-with-admin-token"
  southboundToken: "replace-with-southbound-token"

dns:
  serviceBaseDomain: "apps.example.com"
  dnspod:
    domain: "example.com"

planes:
  - id: "pln_tencent"
    name: "mini-cloud-tencent-ops"
    displayName: "mini-cloud-tencent-ops"
    provider: "tencent"
    region: "ap-guangzhou"
    grpcEndpoint: "replace-with-cloud-plane-grpc-endpoint:18081"
