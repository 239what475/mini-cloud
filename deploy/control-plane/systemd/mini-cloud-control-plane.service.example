[Unit]
Description=mini-cloud control-plane
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=minicloud
Group=minicloud
WorkingDirectory=/opt/mini-cloud/control-plane
ExecStart=/opt/mini-cloud/control-plane/bin/control-plane --config /etc/mini-cloud/control-plane/control-plane.yaml
Restart=always
RestartSec=2
StandardOutput=append:/var/log/mini-cloud/control-plane.log
StandardError=append:/var/log/mini-cloud/control-plane.log
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
