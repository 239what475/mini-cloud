# control-plane 对外监听地址。
# 单活部署里通常直接绑在固定入口机本机网卡上。
MINICLOUD_HTTP_ADDR=127.0.0.1:18080

# control-plane 自己的状态数据库。
# 这一章先按单机单实例 Postgres 来收。
MINICLOUD_CONTROL_PLANE_DATABASE_URL=postgres://mini_cloud:mini_cloud@127.0.0.1:5432/mini_cloud_control_plane?sslmode=disable

# northbound 管理口的管理员 token。
# 这份文件是模板，实际使用时请替换成你自己的值。
MINICLOUD_ADMIN_TOKEN=replace-with-control-plane-admin-token

# control-plane 后台向各个 cloud-plane 拉快照的间隔。
MINICLOUD_PLANE_SYNC_INTERVAL_SECONDS=30

# 单次 service reconcile 最长允许占用多长时间。
# shared host 上的真实进程也应显式固定这个值，而不是完全依赖默认值。
MINICLOUD_SERVICE_RECONCILE_TIMEOUT_SECONDS=1200

# 如果你已经构建了前端静态资源，可以在这里指定。
# MINICLOUD_UI_DIR=/opt/mini-cloud/control-plane/web

# 如果要在绑定 service 域名时自动写腾讯云 CDN 与 DNSPod，可以打开这一组配置。
# MINICLOUD_TENCENT_DOMAIN_PUBLISH_ENABLED=true
# MINICLOUD_TENCENT_DOMAIN_ROOT_DOMAIN=example.com
# MINICLOUD_TENCENT_DOMAIN_RECORD_LINE=默认
# MINICLOUD_TENCENT_CDN_SERVICE_TYPE=web
# MINICLOUD_TENCENT_CDN_AREA=mainland
# MINICLOUD_TENCENT_CDN_PROJECT_ID=0

# 如果要查 Loki，可以填本机或远端 Loki 地址。
# MINICLOUD_LOKI_URL=http://127.0.0.1:3100
# MINICLOUD_LOKI_TENANT_ID=
# MINICLOUD_LOKI_QUERY_TIMEOUT_SECONDS=5
