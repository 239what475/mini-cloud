[Unit]
Description=mini-cloud cloud-plane
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=minicloud
Group=minicloud
# 示例配置的 ingress.caddy.reloadCommand 使用 docker exec reload 外置 Caddy，
# 因此长期运行部署需要把 minicloud 用户加入 docker 组；若改用 systemctl/sudo 等 reload 方式，可按实际权限模型调整。
SupplementaryGroups=docker
WorkingDirectory=/opt/mini-cloud/cloud-plane
ExecStart=/opt/mini-cloud/cloud-plane/bin/cloud-plane --config /etc/mini-cloud/cloud-plane/cloud-plane.yaml
Restart=always
RestartSec=2
StandardOutput=append:/var/log/mini-cloud/cloud-plane.log
StandardError=append:/var/log/mini-cloud/cloud-plane.log
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
