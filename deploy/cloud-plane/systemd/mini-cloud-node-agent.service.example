[Unit]
Description=mini-cloud node agent
After=network-online.target docker.service mini-cloud-cloud-plane.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=minicloud
Group=minicloud
SupplementaryGroups=docker
WorkingDirectory=/opt/mini-cloud/cloud-plane
Environment=MINICLOUD_NODE_AGENT_BIN=/opt/mini-cloud/cloud-plane/bin/node-agent
Environment=MINICLOUD_NODE_AGENT_CONFIG_FILE=/etc/mini-cloud/cloud-plane/node-agent.yaml
ExecStart=/opt/mini-cloud/cloud-plane/bin/start-agent.sh
Restart=always
RestartSec=2
StandardOutput=append:/var/log/mini-cloud/node-agent.log
StandardError=append:/var/log/mini-cloud/node-agent.log
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
