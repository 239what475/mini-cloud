#!/usr/bin/env bash
set -euo pipefail

INSTALL_ROOT={{.InstallRoot}}
AGENT_BINARY_URL={{.AgentBinaryURL}}
CA_CERT_BASE64={{.CACertBase64}}
DOCKER_DAEMON_JSON_BASE64={{.DockerDaemonJSONBase64}}
DOCKER_NO_PROXY={{.DockerNoProxy}}
WORKLOAD_EGRESS_PROXY_ENDPOINT={{.WorkloadEgressProxyEndpoint}}
NODE_AGENT_TOKEN={{.Token}}
BOOTSTRAP_LOG={{.BootstrapLog}}
METADATA_BASE={{.MetadataBase}}

log() {
  printf '[mini-cloud node agent bootstrap] %s\n' "$1" | tee -a "$BOOTSTRAP_LOG"
}

{{.MetadataGetFunction}}

if ! command -v apt-get >/dev/null 2>&1; then
  log 'image does not provide apt-get; node agent bootstrap currently expects a Debian/Ubuntu style image'
  exit 1
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl ca-certificates

touch "$BOOTSTRAP_LOG"
{{- if .MetadataInit}}
{{.MetadataInit}}
{{- end}}
INSTANCE_ID="$(metadata_get {{.MetadataInstanceIDPath}})"
PRIVATE_IP="$(metadata_get {{.MetadataPrivateIPPath}})"
INSTANCE_NAME={{.InstanceName}}

apt-get install -y docker.io
install -d -m 0755 "$INSTALL_ROOT/bin" /var/lib/mini-cloud-node-agent /etc/docker

if [[ -n "$DOCKER_DAEMON_JSON_BASE64" ]]; then
  printf '%s' "$DOCKER_DAEMON_JSON_BASE64" | base64 -d >/etc/docker/daemon.json
fi

if [[ -n "$WORKLOAD_EGRESS_PROXY_ENDPOINT" ]]; then
  install -d -m 0755 /etc/systemd/system/docker.service.d
  cat >/etc/systemd/system/docker.service.d/proxy.conf <<EOF_DOCKER_PROXY
[Service]
Environment="HTTP_PROXY=$WORKLOAD_EGRESS_PROXY_ENDPOINT"
Environment="HTTPS_PROXY=$WORKLOAD_EGRESS_PROXY_ENDPOINT"
Environment="NO_PROXY=$DOCKER_NO_PROXY"
EOF_DOCKER_PROXY
fi

systemctl daemon-reload || true
systemctl enable --now docker
systemctl restart docker

log "download node-agent binary"
curl -fsSL "$AGENT_BINARY_URL" -o "$INSTALL_ROOT/bin/node-agent"
chmod 0755 "$INSTALL_ROOT/bin/node-agent"

CA_CERT="$(printf '%s' "$CA_CERT_BASE64" | base64 -d)"
cat >"$INSTALL_ROOT/node-agent.yaml" <<EOF_NODE_AGENT_CONFIG
server:
  url: {{.ConnectEndpoint}}
  tlsCA: |
$(printf '%s\n' "$CA_CERT" | sed 's/^/    /')
auth:
  token: "$NODE_AGENT_TOKEN"
platform:
  name: {{.PlatformName}}
node:
  provider: {{.Provider}}
  region: {{.Region}}
  name: "$INSTANCE_NAME"
  privateIP: "$PRIVATE_IP"
  instanceID: "$INSTANCE_ID"
  instanceType: {{.InstanceType}}
capacity:
  total:
    cpuMilli: {{.CPUMilli}}
    memoryMi: {{.MemoryMi}}
network:
  egressProxy:
    endpoint: {{.WorkloadEgressProxyEndpoint}}
    noProxy:
{{range .NoProxyItems}}      - {{.}}
{{end}}observability:
  workloadOTLPEndpoint: {{.WorkloadOTLPEndpoint}}
EOF_NODE_AGENT_CONFIG
chmod 0600 "$INSTALL_ROOT/node-agent.yaml"

cat >"$INSTALL_ROOT/bin/start-agent.sh" <<EOF_AGENT_START
#!/usr/bin/env bash
set -euo pipefail
exec {{.NodeAgentBinaryPath}} --config {{.NodeAgentConfigPath}}
EOF_AGENT_START
chmod 0755 "$INSTALL_ROOT/bin/start-agent.sh"

cat >/etc/systemd/system/mini-cloud-node-agent.service <<EOF_SYSTEMD
[Unit]
Description=mini-cloud node agent
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/opt/mini-cloud/bin/start-agent.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF_SYSTEMD

systemctl daemon-reload
systemctl enable --now mini-cloud-node-agent.service
log 'node agent bootstrap completed'
