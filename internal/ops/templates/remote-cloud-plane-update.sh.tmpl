#!/usr/bin/env bash
set -euo pipefail

INSTALL_ROOT={{printf "%q" .InstallRoot}}
CLOUD_PLANE_GRPC_PORT={{.CloudPlaneGRPCPort}}
CLOUD_PLANE_CONFIG_DIR=/etc/mini-cloud/cloud-plane
BOOTSTRAP_LOG="$INSTALL_ROOT/install.log"

cleanup() {
  rm -f \
    /tmp/mini-cloud-cloud-plane \
    /tmp/mini-cloud-node-agent \
    /tmp/mini-cloud-cloud-plane.yaml
}
trap cleanup EXIT

log() {
  install -d -m 0755 "$INSTALL_ROOT"
  printf '[mini-cloud update] %s\n' "$*" | tee -a "$BOOTSTRAP_LOG"
}

require_existing_install() {
  if [[ ! -d "$INSTALL_ROOT/bin" || ! -d "$INSTALL_ROOT/artifacts" || ! -d "$CLOUD_PLANE_CONFIG_DIR" ]]; then
    log "cloud-plane is not installed; run minictl install first"
    exit 1
  fi
  if [[ ! -f /etc/systemd/system/mini-cloud-cloud-plane.service ]]; then
    log "cloud-plane systemd unit is missing; run minictl install first"
    exit 1
  fi
}

install_binaries() {
  install -m 0755 /tmp/mini-cloud-cloud-plane "$INSTALL_ROOT/bin/cloud-plane"
  install -m 0755 /tmp/mini-cloud-node-agent "$INSTALL_ROOT/artifacts/node-agent-linux-amd64"
}

install_config() {
  install -m 0600 /tmp/mini-cloud-cloud-plane.yaml "$CLOUD_PLANE_CONFIG_DIR/cloud-plane.yaml"
}

wait_for_tcp() {
  local host="$1"
  local port="$2"
  local service="$3"
  for _ in $(seq 1 60); do
    if timeout 1 bash -c "</dev/tcp/$host/$port" >/dev/null 2>&1; then
      return
    fi
    sleep 2
  done
  journalctl -u "$service" --no-pager -n 120 || true
  exit 1
}

require_existing_install
install_binaries
install_config
systemctl restart mini-cloud-cloud-plane.service
wait_for_tcp 127.0.0.1 "$CLOUD_PLANE_GRPC_PORT" mini-cloud-cloud-plane.service
log "mini-cloud cloud-plane update completed"
